{
  "name": "takatrace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @takatrace/mobile start",
    "backend": "yarn workspace @takatrace/backend dev",
    "dev": "concurrently \"yarn backend\" \"yarn mobile\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
